# ==============================================================================
# MysteryMart — Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR CREDENTIALS
# NEVER COMMIT REAL API KEYS OR PRODUCTION PASSWORDS TO GIT!
# ==============================================================================

# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production

# SQL Database Configuration
# Local SQLite fallback: sqlite:///mysterymart.db
# Render PostgreSQL Example: postgresql://user:password@hostname:5432/dbname
DATABASE_URL=sqlite:///mysterymart.db

# NoSQL Database Configuration (Optional for Chat History & Feedback)
# If not provided, MysteryMart uses an in-memory/fallback storage safely.
# MongoDB Atlas Example: mongodb+srv://username:password@cluster.mongodb.net/mysterymart?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=mysterymart_nosql

# AI Assistant Configuration
# Options: 'fallback' (rule & FAQ engine - works 100% without external API key),
#          'gemini' (Google Gemini 1.5/2.0 API),
#          'openai' (OpenAI GPT-4o / GPT-3.5)
AI_PROVIDER=fallback
GEMINI_API_KEY=
OPENAI_API_KEY=

# Third-Party Weather API Configuration (Default Open-Meteo requires no key!)
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_API_TIMEOUT=4

# Server Port (Render sets this dynamically via PORT env var)
PORT=5000
